name: CI

on:
  push:
    branches: ['**']
  pull_request:
  workflow_dispatch:

jobs:
  test:
    name: Test on Node ${{ matrix.node }}
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        node: [18, 20, 22]

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node }}

      - name: Syntax check
        run: npm run lint

      - name: Run engine tests
        run: npm test

  xray:
    name: Self X-Ray
    runs-on: ubuntu-latest
    needs: test
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22

      # Dogfooding: the repo grades itself on every push, using the
      # workflow token so we never hit the anonymous rate limit.
      - name: Grade this repository
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          node bin/xray.js "$GITHUB_REPOSITORY" --markdown >> "$GITHUB_STEP_SUMMARY"

# ---------------------------------------------------------------------------
# To enable this workflow, copy it into place and push:
#
#   mkdir -p .github/workflows
#   cp .github/ci-workflow.yml.example .github/workflows/ci.yml
#   git add .github/workflows/ci.yml && git commit -m "ci: enable" && git push
#
# It runs `npm test` on Node 18/20/22, then grades this repo with the X-Ray
# CLI and writes the Markdown report straight into the Actions job summary.
# ---------------------------------------------------------------------------
